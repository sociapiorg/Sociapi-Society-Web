{
  "redirects": [
    { "source": "/programs", "destination": "/opportunities", "permanent": true },
    { "source": "/partner", "destination": "/partner-with-us", "permanent": true },
    { "source": "/career", "destination": "/opportunities", "permanent": true },
    { "source": "/labs", "destination": "/services", "permanent": true },
    { "source": "/faq", "destination": "/faqs", "permanent": true }
  ],
  "rewrites": [
    { "source": "/verify/:certificateId", "destination": "/verify" }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, max-image-preview:large" }
      ]
    },
    {
      "source": "/verify/:certificateId",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
